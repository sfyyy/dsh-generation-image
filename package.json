{
  "name": "@dsh-extension/dsh-generation-image",
  "version": "1.0.0",
  "description": "On-demand image generation for DeepSeek Harness (DSH): a generate_image tool that calls your own OpenAI-compatible image URL + API key and delivers the image into the session",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "image-generation",
    "text-to-image",
    "generate-image",
    "gpt-image",
    "openai",
    "openai-compatible",
    "images",
    "xiaoyaoapi",
    "agent",
    "llm-agent"
  ],
  "license": "MIT",
  "author": "sfyyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfyyy/dsh-gengration-image.git"
  },
  "bugs": {
    "url": "https://github.com/sfyyy/dsh-gengration-image/issues"
  },
  "homepage": "https://github.com/sfyyy/dsh-gengration-image#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/index.test.js",
    "prepack": "npm test"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
